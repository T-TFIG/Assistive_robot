<?xml version="1.0" encoding="utf-8"?>
<robot name="4_wheel_mobile_assem" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="0.00628429000821322 0.0 0.09385603458840618" rpy="0.0 0.0 0.0"/>
      <mass value="20.0"/>
      <inertia ixx="0.8" iyy="0.8" izz="1.2" ixy="0.0" iyz="0.0" ixz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://mobile_robot/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.2 1.0 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://mobile_robot/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="omni_wheel_1">
    <inertial>
      <origin xyz="0 0 -0.011" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0008" iyy="0.0008" izz="0.0015" ixy="0.0" iyz="0.0" ixz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0 0.018 0.715" rpy="1.57079 -1.57079 0"/>
      <geometry>
        <mesh filename="package://mobile_robot/meshes/Omni_wheel.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_grey"><color rgba="0.3 0.3 0.3 1.0"/></material>
    </visual>
    <collision>
      <geometry><sphere radius="0.0635"/></geometry>
    </collision>
  </link>
  <joint name="mobile_base_Revolute_1" type="continuous">
    <origin xyz="0.375 0.395 0.025" rpy="-1.57079 0 0"/>
    <parent link="base_link"/><child link="omni_wheel_1"/><axis xyz="0 0 1"/>
  </joint>

  <link name="omni_wheel_2">
