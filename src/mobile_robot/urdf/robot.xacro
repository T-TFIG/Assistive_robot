<?xml version="1.0" encoding="utf-8"?>
<robot name="4_wheel_mobile_assem" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="0.0 0.0 0.09" rpy="0.0 0.0 0.0"/>
      <mass value="1.0"/>
      <inertia ixx="0.004" iyy="0.004" izz="0.008" ixy="0.0" iyz="0.0" ixz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://mobile_robot/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.2 1.0 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.09" rpy="0 0 0"/>
      <geometry>
        <box size="0.6 0.5 0.1"/>
      </geometry>
    </collision>
  </link>

  <link name="omni_wheel_1">
    <inertial>
      <origin xyz="0 0 -0.011" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0008" iyy="0.0008" izz="0.0015" ixy="0.0" iyz="0.0" ixz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0 0.018 0.715" rpy="1.57079 -1.57079 0"/>
      <geometry>
        <mesh filename="package://mobile_robot/meshes/Omni_wheel.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_grey"><color rgba="0.3 0.3 0.3 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.0635" length="0.04"/>
      </geometry>
    </collision>
  </link>
  <joint name="mobile_base_Revolute_1" type="continuous">
    <origin xyz="0.375 0.375 0.025" rpy="-1.57079 0 0"/>
    <parent link="base_link"/>
    <child link="omni_wheel_1"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.5" friction="0.0"/>
  </joint>

  <link name="omni_wheel_2">
    <inertial>
      <origin xyz="0 0 -0.011" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0008" iyy="0.0008" izz="0.0015" ixy="0.0" iyz="0.0" ixz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0 -0.018 -0.715" rpy="-1.57079 1.57079 0"/>
      <geometry>
        <mesh filename="package://mobile_robot/meshes/Omni_wheel.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_grey"><color rgba="0.3 0.3 0.3 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.0635" length="0.04"/>
      </geometry>
    </collision>
  </link>
  <joint name="mobile_base_Revolute_2" type="continuous">
    <origin xyz="0.375 -0.375 0.025" rpy="-1.57079 0 0"/>
    <parent link="base_link"/>
    <child link="omni_wheel_2"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.5" friction="0.0"/>
  </joint>

  <link name="omni_wheel_3">
    <inertial>
      <origin xyz="0 0 -0.011" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0008" iyy="0.0008" izz="0.0015" ixy="0.0" iyz="0.0" ixz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0 -0.018 -0.715" rpy="-1.57079 1.57079 0"/>
      <geometry>
        <mesh filename="package://mobile_robot/meshes/Omni_wheel.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_grey"><color rgba="0.3 0.3 0.3 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.0635" length="0.04"/>
      </geometry>
    </collision>
  </link>
  <joint name="mobile_base_Revolute_3" type="continuous">
    <origin xyz="-0.375 -0.375 0.025" rpy="-1.57079 0 0"/>
    <parent link="base_link"/>
    <child link="omni_wheel_3"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.5" friction="0.0"/>
  </joint>

  <link name="omni_wheel_4">
    <inertial>
      <origin xyz="0 0 -0.011" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0008" iyy="0.0008" izz="0.0015" ixy="0.0" iyz="0.0" ixz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0 0.018 0.715" rpy="1.57079 -1.57079 0"/>
      <geometry>
        <mesh filename="package://mobile_robot/meshes/Omni_wheel.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_grey"><color rgba="0.3 0.3 0.3 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.0635" length="0.04"/>
      </geometry>
    </collision>
  </link>
  <joint name="mobile_base_Revolute_4" type="continuous">
    <origin xyz="-0.375 0.375 0.025" rpy="-1.57079 0 0"/>
    <parent link="base_link"/>
    <child link="omni_wheel_4"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.5" friction="0.0"/>
  </joint>

  <link name="realsense">
    <inertial>
      <origin xyz="0 0 0.013" rpy="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.0002" iyy="0.0002" izz="0.0003" ixy="0.0" iyz="0.0" ixz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.026" rpy="0 0 -1.57079"/>
      <geometry>
        <mesh filename="package://mobile_robot/meshes/Realsense_D455.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_grey"><color rgba="0.3 0.3 0.3 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.026" rpy="0 0 -1.57079"/>
      <geometry>
        <mesh filename="package://mobile_robot/meshes/Realsense_D455.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <joint name="camera_joint" type="fixed">
    <origin xyz="0.474 0.0 0.1355" rpy="-3.141592653589793 -1.5707963267948966 0"/>
    <parent link="base_link"/>
    <child link="realsense"/>
  </joint>

  <!-- ═══════════════════════════════════════════════════════
       GAZEBO — only these blocks changed from your original:

       1. All 4 wheels now have the same friction values
       2. mu1=1.5  (high rolling grip — prevents forward slip)
       3. mu2=0.5  (moderate lateral — skid steer needs some grip to turn)
       4. fdir1=1 0 0  (tells ODE the rolling direction in link frame)
       5. kp/kd/minDepth added (stable contact, prevents sinking/bouncing)
       6. joint dynamics: damping=0.5 friction=0.0 (no stiction fighting PID)
       ═══════════════════════════════════════════════════════ -->

  <gazebo reference="base_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <visual>
      <material>
        <ambient>0.2 0.2 1.0 1.0</ambient>
        <diffuse>0.2 0.2 1.0 1.0</diffuse>
        <specular>0.1 0.1 0.1 1.0</specular>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="omni_wheel_1">
    <mu1>1.5</mu1>
    <mu2>0.5</mu2>
    <fdir1>1 0 0</fdir1>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="omni_wheel_2">
    <mu1>1.5</mu1>
    <mu2>0.5</mu2>
    <fdir1>1 0 0</fdir1>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="omni_wheel_3">
    <mu1>1.5</mu1>
    <mu2>0.5</mu2>
    <fdir1>1 0 0</fdir1>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="omni_wheel_4">
    <mu1>1.5</mu1>
    <mu2>0.5</mu2>
    <fdir1>1 0 0</fdir1>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
    <material>Gazebo/Black</material>
  </gazebo>

  <xacro:realsense_sensor name="base_camera" topics_ns="base_cam" parent_link="realsense">
    <origin xyz="0.0 0 0.0" rpy="0 0 0"/>
  </xacro:realsense_sensor>

</robot>