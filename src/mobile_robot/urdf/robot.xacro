<?xml version="1.0" encoding="utf-8"?>
<robot name="4_wheel_mobile_assem">

  <!-- DUMMY ROOT TO SATISFY KDL -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <!-- BASE LINK -->
  <link name="base_link">
    <inertial>
      <origin xyz="0.00628429000821322 0.0 0.09385603458840618" rpy="0.0 0.0 0.0"/>
      <mass value="987.3844207986756"/>
      <inertia ixx="40.57825725748298" iyy="87.33699297862528" izz="122.02543924646025" 
               ixy="0.0" iyz="0.0" ixz="-0.6159379832813523"/>
    </inertial>
    
    <visual name="base_link_visual">
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://mobile_robot/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    
    <collision name="base_link_collision">
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://mobile_robot/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- WHEEL 1 (Front Left) -->
  <link name="omni_wheel_1">
    <inertial>
      <origin xyz="-7.970962720094121e-06 -6.877816728989572e-06 -0.01147703773614026" rpy="0.0 0.0 0.0"/>
      <mass value="1.7319883752876981"/>
      <inertia ixx="0.002224867748533532" iyy="0.0022250042535725822" izz="0.004048574614964773" 
               ixy="-4.500394812853581e-07" iyz="4.899447401951473e-08" ixz="5.879718084633723e-08"/>
    </inertial>
    
    <visual name="omni_wheel_1_visual">
      <origin xyz="2.2665481083095073e-08 0.018031436920169994 0.7154857177799999" rpy="1.5707963267948968 -1.5707963267948966 0"/>
      <geometry>
        <mesh filename="package://mobile_robot/meshes/Omni_wheel.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    
    <collision name="omni_wheel_1_collision">
      <origin xyz="2.2665481083095073e-08 0.018031436920169994 0.7154857177799999" rpy="1.5707963267948968 -1.5707963267948966 0"/>
      <geometry>
        <mesh filename="package://mobile_robot/meshes/Omni_wheel.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="wheel_1_joint" type="continuous">
    <origin xyz="-0.375 0.395 0.025" rpy="-1.5707963267948966 0.0 0.0"/>
    <parent link="base_link"/>
    <child link="omni_wheel_1"/>
    <axis xyz="0.0 0.0 1.0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- WHEEL 2 (Front Right) -->
  <link name="omni_wheel_2">
    <inertial>
      <origin xyz="-7.970962720094121e-06 -6.877816728980691e-06 -0.01147703773614026" rpy="0.0 0.0 0.0"/>
      <mass value="1.7319883752876981"/>
      <inertia ixx="0.002224867748534254" iyy="0.002225004253573304" izz="0.004048574614964745" 
               ixy="-4.5003948128188864e-07" iyz="4.8994474016045286e-08" ixz="5.8797180790826076e-08"/>
    </inertial>
    
    <visual name="omni_wheel_2_visual">
      <origin xyz="2.2665481083095073e-08 0.018031436920170004 0.7154857177799999" rpy="1.5707963267948968 -1.5707963267948966 0"/>
      <geometry>
        <mesh filename="package://mobile_robot/meshes/Omni_wheel.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    
    <collision name="omni_wheel_2_collision">
      <origin xyz="2.2665481083095073e-08 0.018031436920170004 0.7154857177799999" rpy="1.5707963267948968 -1.5707963267948966 0"/>
      <geometry>
        <mesh filename="package://mobile_robot/meshes/Omni_wheel.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="wheel_2_joint" type="continuous">
    <origin xyz="0.375 0.395 0.025" rpy="-1.5707963267948966 0.0 0.0"/>
    <parent link="base_link"/>
    <child link="omni_wheel_2"/>
    <axis xyz="0.0 0.0 1.0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- WHEEL 3 (Rear Left) -->
  <link name="omni_wheel_3">
    <inertial>
      <origin xyz="-7.970962720094121e-06 6.877816728985131e-06 -0.011522962255859852" rpy="0.0 0.0 0.0"/>
      <mass value="1.7319883752876981"/>
      <inertia ixx="0.0022248677485343094" iyy="0.0022250042535733594" izz="0.004048574614964773" 
               ixy="4.5003948128188864e-07" iyz="4.8994474016045286e-08" ixz="-5.8797180790826076e-08"/>
    </inertial>
    
    <visual name="omni_wheel_3_visual">
      <origin xyz="2.2665481083095073e-08 -0.01803143692017 -0.7384857177720001" rpy="-1.5707963267948966 1.5707963267948966 0"/>
      <geometry>
        <mesh filename="package://mobile_robot/meshes/Omni_wheel.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    
    <collision name="omni_wheel_3_collision">
      <origin xyz="2.2665481083095073e-08 -0.01803143692017 -0.7384857177720001" rpy="-1.5707963267948966 1.5707963267948966 0"/>
      <geometry>
        <mesh filename="package://mobile_robot/meshes/Omni_wheel.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="wheel_3_joint" type="continuous">
    <origin xyz="-0.375 -0.395 0.025" rpy="1.5707963267948966 0.0 0.0"/>
    <parent link="base_link"/>
    <child link="omni_wheel_3"/>
    <axis xyz="0.0 0.0 1.0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- WHEEL 4 (Rear Right) -->
  <link name="omni_wheel_4">
    <inertial>
      <origin xyz="-7.970962720094121e-06 6.877816728985131e-06 -0.011522962255859852" rpy="0.0 0.0 0.0"/>
      <mass value="1.7319883752876981"/>
      <inertia ixx="0.0022248677485343094" iyy="0.002225004253573415" izz="0.004048574614964745" 
               ixy="4.500394812853581e-07" iyz="4.8994474016045286e-08" ixz="-5.879718081858165e-08"/>
    </inertial>
    
    <visual name="omni_wheel_4_visual">
      <origin xyz="2.2665481083095073e-08 -0.01803143692017 -0.7384857177720001" rpy="-1.5707963267948966 1.5707963267948966 0"/>
      <geometry>
        <mesh filename="package://mobile_robot/meshes/Omni_wheel.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    
    <collision name="omni_wheel_4_collision">
      <origin xyz="2.2665481083095073e-08 -0.01803143692017 -0.7384857177720001" rpy="-1.5707963267948966 1.5707963267948966 0"/>
      <geometry>
        <mesh filename="package://mobile_robot/meshes/Omni_wheel.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="wheel_4_joint" type="continuous">
    <origin xyz="0.375 -0.395 0.025" rpy="1.5707963267948966 0.0 0.0"/>
    <parent link="base_link"/>
    <child link="omni_wheel_4"/>
    <axis xyz="0.0 0.0 1.0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- CAMERA (RealSense D455) -->
  <link name="realsense">
    <inertial>
      <origin xyz="6.359106729602714e-05 -0.0001583183035289228 0.013103406900131134" rpy="0.0 0.0 0.0"/>
      <mass value="0.4224343307990776"/>
      <inertia ixx="0.0005263815553470524" iyy="4.808114888894821e-05" izz="0.0005349726197919043" 
               ixy="-3.4306312466689594e-07" iyz="3.9088259249671483e-07" ixz="2.188450578845258e-07"/>
    </inertial>
    
    <visual name="realsense_visual">
      <origin xyz="-4.5257177916369075e-09 1.5070762415803906e-11 0.025999999999999943" rpy="0.0 0.0 -1.5707963267948968"/>
      <geometry>
        <mesh filename="package://mobile_robot/meshes/Realsense_D455.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    
    <collision name="realsense_collision">
      <origin xyz="-4.5257177916369075e-09 1.5070762415803906e-11 0.025999999999999943" rpy="0.0 0.0 -1.5707963267948968"/>
      <geometry>
        <mesh filename="package://mobile_robot/meshes/Realsense_D455.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="camera_joint" type="fixed">
    <origin xyz="0.474 0.0 0.1355" rpy="-3.141592653589793 -1.5707963267948966 0"/>
    <parent link="base_link"/>
    <child link="realsense"/>
  </joint>

  <!-- GAZEBO SPECIFIC SETTINGS -->
  
  <!-- Global Physics -->
  <gazebo>
    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>
  </gazebo>

  <!-- Material colors for Gazebo -->
  <gazebo reference="base_link">
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="omni_wheel_1">
    <material>Gazebo/Black</material>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
  </gazebo>

  <gazebo reference="omni_wheel_2">
    <material>Gazebo/Black</material>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
  </gazebo>

  <gazebo reference="omni_wheel_3">
    <material>Gazebo/Black</material>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
  </gazebo>

  <gazebo reference="omni_wheel_4">
    <material>Gazebo/Black</material>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
  </gazebo>

  <gazebo reference="realsense">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <gazebo>
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
        <ros>
        <namespace>/</namespace>
        </ros>
    </plugin>
  </gazebo>

</robot>