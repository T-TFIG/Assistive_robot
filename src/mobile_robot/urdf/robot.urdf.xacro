<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mobile_robot">

  <xacro:include filename="robot.xacro"/>
  
  <xacro:include filename="ros2_control.xacro"/>

  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>

  <xacro:include filename="Realsense.xacro"/>

  <xacro:ur_robot
    name="ur5"
    tf_prefix="ur5_"
    parent="base_link"
    joint_limits_parameters_file="$(find ur_description)/config/ur5/joint_limits.yaml"
    kinematics_parameters_file="$(find ur_description)/config/ur5/default_kinematics.yaml"
    physical_parameters_file="$(find ur_description)/config/ur5/physical_parameters.yaml"
    visual_parameters_file="$(find ur_description)/config/ur5/visual_parameters.yaml">
    <origin xyz="0.35 0.0 0.20" rpy="0 0 0" />
    <xacro:property name="initial_positions" value="${dict(shoulder_pan_joint=1.57, shoulder_lift_joint=-1.57, elbow_joint=0.0, wrist_1_joint=-1.57, wrist_2_joint=0.0, wrist_3_joint=0.0)}" />
  </xacro:ur_robot>

  

</robot>